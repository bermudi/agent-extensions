{
  "name": "agent-extensions",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun run test:extensions && bun run test:agent-pty",
    "test:extensions": "bun run test:arena && bun run test:pi-debate && bun run test:delegate && bun run test:supervise && bun run test:roundtable && bun run test:trim-context",
    "test:arena": "bun test pi/arena",
    "test:pi-debate": "bun test pi/pi-debate",
    "test:delegate": "bun test pi/delegate",
    "test:supervise": "bun test pi/supervise",
    "test:roundtable": "bun test pi/roundtable",
    "test:trim-context": "bun test pi/trim-context",
    "test:agent-pty": "cd pi/agent-pty && bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@marcfargas/pi-test-harness": "^0.5.0",
    "@mariozechner/pi-agent-core": "npm:@earendil-works/pi-agent-core@^0.75.3",
    "@mariozechner/pi-ai": "npm:@earendil-works/pi-ai@^0.75.3",
    "@mariozechner/pi-coding-agent": "npm:@earendil-works/pi-coding-agent@^0.75.3",
    "@mariozechner/pi-tui": "npm:@earendil-works/pi-tui@^0.75.3"
  }
}
