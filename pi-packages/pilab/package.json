{
  "name": "pilab",
  "private": true,
  "type": "module",
  "description": "Sandboxed pi launcher: run the real pi CLI against disposable config dirs without touching ~/.pi/agent.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "prettier --write \"*.ts\"",
    "build": "bun build --compile pilab.ts --outfile dist/pilab"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2"
  }
}
