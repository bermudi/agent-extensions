{
  "name": "bermudis-pi-goodies",
  "version": "0.5.2",
  "private": false,
  "description": "A bundle of small, frequently-used Pi extensions.",
  "keywords": ["pi-package"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bermudi/agent-extensions.git",
    "directory": "pi-packages/bermudis-pi-goodies"
  },
  "type": "module",
  "files": ["*.ts", "!*.test.ts", "!*.bundle.ts", "README.md"],
  "pi": {
    "extensions": ["./index.ts"]
  },
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=neutral --packages=external --format=esm --banner:js=\"// @ts-nocheck\" --outfile=bermudis-pi-goodies.bundle.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "prettier --write \"*.ts\" \"!*.bundle.ts\""
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.0",
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "esbuild": "^0.27.0",
    "prettier": "^3.8.4"
  }
}
