{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "lib": ["ESNext", "DOM"],
    "types": ["bun"]
  },
  "include": ["./*.ts"],
  "exclude": ["node_modules", "**/*.test.ts"]
}
