[Unit]
Description=zen-relay — all-local OpenCode Zen multi-egress relay
After=network-online.target zen-relay-tunnel@neon.service zen-relay-tunnel@lithium.service zen-relay-tunnel@silicon.service
Wants=network-online.target zen-relay-tunnel@neon.service zen-relay-tunnel@lithium.service zen-relay-tunnel@silicon.service

[Service]
ExecStart=%h/.local/bin/zen-relay
EnvironmentFile=%h/.config/zen-relay/zen-relay.env
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
