[Unit]
Description=zen-relay leaf — OpenCode Zen gateway forwarder (this server's key)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/srv/zen-relay/zen-relay leaf
EnvironmentFile=/srv/zen-relay/zen-relay.env
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
