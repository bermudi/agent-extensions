diff --git a/node_modules/critique/src/review/agent-launch.ts b/src/review/agent-launch.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f1eb53646ef35d7d06be8e1d06240e81ceb34e42
--- /dev/null
+++ b/src/review/agent-launch.ts
@@ -0,0 +1,94 @@
+// Resolves built-in and user-provided ACP agent launch commands.
+// Commands are always passed directly to Bun.spawn as argv, never through a shell.
+
+import path from "path"
+
+export type AgentType = "opencode" | "claude"
+export type SessionListFallback = "claude-files"
+
+export interface AcpAgentLaunch {
+  id: string
+  command: string[]
+  custom: boolean
+  cwd?: string
+  sessionListFallback?: SessionListFallback
+}
+
+export interface AcpAgentLaunchOptions {
+  agent?: string
+  agentCommand?: string
+  agentArgs?: string[]
+  cwd?: string
+}
+
+const BUILTIN_AGENTS: Record<AgentType, Omit<AcpAgentLaunch, "custom">> = {
+  opencode: {
+    id: "opencode",
+    command: ["opencode", "acp"],
+  },
+  claude: {
+    id: "claude",
+    command: ["bunx", "@zed-industries/claude-code-acp"],
+    sessionListFallback: "claude-files",
+  },
+}
+
+function isAgentType(value: string): value is AgentType {
+  return value === "opencode" || value === "claude"
+}
+
+function createCustomLaunch(command: string[], id?: string, cwd?: string): AcpAgentLaunch {
+  if (!Array.isArray(command) || command.some(part => typeof part !== "string")) {
+    throw new Error("ACP agent command must be an array of strings")
+  }
+
+  const executable = command[0]?.trim()
+  if (!executable) {
+    throw new Error("ACP agent command must not be empty")
+  }
+
+  return {
+    id: id || path.basename(executable) || executable,
+    command: [executable, ...command.slice(1)],
+    custom: true,
+    ...(cwd ? { cwd } : {}),
+  }
+}
+
+export function resolveAcpAgentLaunch(options: AcpAgentLaunchOptions = {}): AcpAgentLaunch {
+  const { agent, agentCommand, agentArgs = [], cwd } = options
+
+  if (agentCommand !== undefined && agent !== undefined) {
+    throw new Error("--agent and --agent-command cannot be used together")
+  }
+  if (agentCommand === undefined && agentArgs.length > 0) {
+    throw new Error("--agent-arg requires --agent-command")
+  }
+
+  if (agentCommand !== undefined) {
+    return createCustomLaunch([agentCommand, ...agentArgs], undefined, cwd)
+  }
+
+  const agentName = agent ?? "opencode"
+  if (!isAgentType(agentName)) {
+    throw new Error(`Unknown agent: ${agentName}. Supported built-ins: opencode, claude; use --agent-command for another ACP agent`)
+  }
+
+  const launch = BUILTIN_AGENTS[agentName]
+  return {
+    ...launch,
+    command: [...launch.command],
+    custom: false,
+  }
+}
+
+export function restoreAcpAgentLaunch(
+  agent: string,
+  agentCommand?: string[],
+  cwd?: string,
+): AcpAgentLaunch {
+  if (agentCommand !== undefined) {
+    return createCustomLaunch(agentCommand, agent, cwd)
+  }
+  return resolveAcpAgentLaunch({ agent })
+}
