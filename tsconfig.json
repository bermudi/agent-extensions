{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "pi/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "reference",
    "pi/experiments",
    "**/*.bundle.ts",
    "**/*.test.ts",
    "**/__tests__/**"
  ]
}
